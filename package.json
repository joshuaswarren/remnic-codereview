{
  "name": "remnic-codereview",
  "version": "0.1.0",
  "description": "Memory-augmented code review bot",
  "type": "module",
  "license": "MIT",
  "bin": {
    "remnic-codereview": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0 <26"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=10 'src/**/*.test.ts' 'tests/**/*.test.ts'",
    "test-unit": "tsx --test --test-concurrency=10 'src/**/*.test.ts'",
    "lint": "biome check .",
    "lint-fix": "biome check --write .",
    "format": "biome format --write .",
    "demo:video": "node scripts/render-challenge-demo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@remnic/core": "1.1.6",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "openai": "^6.35.0",
    "simple-git": "^3.36.0",
    "zod": "^3.25.76"
  }
}
